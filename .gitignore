# Godot
.godot/
*.translation
# export_presets.cfg is tracked: it holds no secrets (Godot keeps export
# credentials in .godot/export_credentials.cfg).
builds/

# Real card data comes from tools/import_scryfall.py. The card metadata is
# tracked (each set's trimmed Scryfall data and the built cards.json, a few MB
# of text), so any clone has every imported set; the images (several GB) stay
# out of git and are copied between machines by hand.
data/real/*
!data/real/sets/
!data/real/cards.json
!data/real/.gdignore

# OS / editor
.DS_Store
Thumbs.db
*.tmp

# Python
__pycache__/

# The user's local asset workbench (import-ready art lives here before it is copied in).
/dev/

# Kiln (tools/kiln): installed with npm ci, never committed.
node_modules/
.kiln/
