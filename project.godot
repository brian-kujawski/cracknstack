; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pickup"
config/description="Sort a game store's worth of Magic cards back into their binders."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

CardDatabase="*res://scripts/data/card_database.gd"
Controls="*res://scripts/input/controls.gd"
Progression="*res://scripts/progression/progression.gd"
Achievements="*res://scripts/progression/achievements.gd"
SceneFlow="*res://scripts/ui/scene_flow.gd"
Settings="*res://scripts/settings/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
